# 登录态缓存（per-机器 per-微信账号，首次 --headful 扫码生成，不随 skill 分发）
.gzh-profile-dir/

# 运行时产物（预览/截图/日志，可删）
outputs/

# 本地工作记忆（含个人对话数据，绝不公开）
.workbuddy/

# 调试残留文件
_v1.txt
_ve1.txt
*.bak*
*.bak_before_*

# Python 编译产物（历史遗留曾误提交过 .pyc，勿再入库）
__pycache__/
*.pyc

# 脚本：只保留 SKILL.md 正式引用的主线脚本，其余开发调试/历史脚本一律忽略
# 历史脚本归档目录（本地留存、可查可逆，不入库）
scripts/archive/

# scripts 根目录只跟踪下列 19 个主线脚本
scripts/*.py
!scripts/publish_full_v2.py
!scripts/validate_gzh_html.py
!scripts/fix_quotes.py
!scripts/wrap_preview.py
!scripts/extract_docx.py
!scripts/component_lint.py
!scripts/stress_test.py
!scripts/set_cover_to_draft.py
!scripts/add_card_to_draft.py
!scripts/add_body_images_to_draft.py
!scripts/remove_tail_card_from_draft.py
!scripts/check_cover.py
!scripts/fetch_ai_news.py
!scripts/analyze_viral_article.py
!scripts/generate_titles.py
!scripts/cover_styles.py
!scripts/gen_covers_batch.py
!scripts/gen_minicpm_memory_graph.py
!scripts/fix_body_image_in_draft.py
scripts/batch*.ps1
